# --- Secrets -----------------------------------------------------------------
# A pattern without a slash matches at any depth, so this covers .env,
# Backend/.env and Frontend/.env in one line.
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
newenv/

# --- Tooling caches ----------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Generated runtime output ------------------------------------------------
# The pre-audit implementation wrote every answer to Backend/data/ and two of
# those files were committed. Nothing here belongs in version control.
Backend/data/

# --- Evaluation --------------------------------------------------------------
# Fixtures ARE tracked (they define the quality gate). Reports are not: they
# embed question text and are regenerated on every run.
Backend/eval/reports/

# --- Editor / OS -------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
