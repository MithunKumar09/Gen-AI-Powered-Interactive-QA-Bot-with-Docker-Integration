# =============================================================================
# Copy to .env and fill in. NEVER commit the filled-in file.
#
# The keys previously committed to this repository are permanently compromised
# and must be revoked, not reused. See DEPLOYMENT.md "Rotate credentials".
# =============================================================================

# --- Secrets -----------------------------------------------------------------
# Cohere API key.                        https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_new_cohere_key_here
# Pinecone API key.                      https://app.pinecone.io/
PINECONE_API_KEY=your_new_pinecone_key_here
# Shared secret for the frontend -> backend hop. Any long random string.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=generate_a_long_random_string
# HMAC key used to derive session_scope from the raw browser session id, so the
# raw id never reaches Pinecone or the logs. Backend-only; never sent anywhere.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# NOTE: rotating this makes all existing stored documents unreachable. They are
# not leaked (nobody can derive their scope) and retention cleanup removes them.
SESSION_SCOPE_KEY=generate_a_different_long_random_string
# Passphrase visitors type before they can use the demo. Not authentication.
# A basic spend guard when PUBLIC_DEMO_MODE is off; when it is on, this value is
# intentionally displayed on the login page.
DEMO_PASSWORD=choose_a_demo_passphrase

# --- Pinecone ----------------------------------------------------------------
PINECONE_INDEX=qa-bot-v1
PINECONE_NAMESPACE=demo-v1
# Pinecone Starter permits serverless indexes only in aws / us-east-1.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Cohere models -----------------------------------------------------------
# Chat model. Candidates evaluated in Phase 5: command-a-03-2025,
# command-a-plus-05-2026. There is no silent fallback: an unsupported value
# here is a startup failure.
COHERE_CHAT_MODEL=command-a-03-2025
# Embedding model and output dimension. COHERE_EMBED_DIMENSION MUST equal the
# dimension of PINECONE_INDEX; /ready asserts this and fails loudly if not.
COHERE_EMBED_MODEL=embed-v4.0
COHERE_EMBED_DIMENSION=1024
# Reranking. Candidates: rerank-v3.5 (4k ctx), rerank-v4.0-fast (32k ctx).
COHERE_RERANK_MODEL=rerank-v3.5
ENABLE_RERANK=true

# --- Retrieval ---------------------------------------------------------------
TOP_K=20
RERANK_TOP_N=5
# Abstention thresholds. Calibrated in Phase 5 -- these are starting values,
# not validated constants. VECTOR_MIN_SCORE is a cosine floor on candidates;
# RERANK_MIN_SCORE is the primary abstention signal (Cohere does not guarantee
# relevance_score is normalised to 0-1, so it must be measured, not assumed).
VECTOR_MIN_SCORE=0.0
RERANK_MIN_SCORE=0.20
MIN_EVIDENCE_CHUNKS=1

# --- Ingestion limits --------------------------------------------------------
# These are bound by startup invariants; see rag_core/config.py. In particular
#   MAX_EXTRACTED_CHARS <= MAX_CHUNKS * (CHUNK_CHARS - CHUNK_OVERLAP) + CHUNK_OVERLAP
#   CHUNK_CHARS * 4 + METADATA_OVERHEAD_BUDGET <= METADATA_MAX_BYTES
# Changing one without the others will fail startup with an explicit message.
CHUNK_CHARS=1200
CHUNK_OVERLAP=200
MAX_CHUNKS=320
MAX_EXTRACTED_CHARS=300000
MAX_PAGES=40
MAX_UPLOAD_MB=10
MAX_QUESTION_CHARS=800
# Pinecone's hard metadata ceiling is 40960 bytes per record; stay below it.
METADATA_MAX_BYTES=32768
METADATA_OVERHEAD_BUDGET=2048

# --- Ingest verification -----------------------------------------------------
# Pinecone writes are eventually consistent, so ingestion is confirmed by
# polling list(prefix=...) until the observed id set matches exactly.
INGEST_VERIFY_TIMEOUT_S=20
INGEST_VERIFY_POLL_MS=500

# --- Retention ---------------------------------------------------------------
# Used by scripts/cleanup_orphans.py, which is MANUAL and never self-executes.
# Storage is not self-bounding; see DEPLOYMENT.md "Cleanup cadence".
RETENTION_HOURS=24

# --- Rate limits -------------------------------------------------------------
# Four independent limits, all enforced at once. A composite key would be
# defeated by minting session ids, so per-IP and per-scope are separate.
# _APP_PROCESS is PER GUNICORN WORKER and resets on restart -- a best-effort
# demo spend guard, NOT an enforceable account-wide provider budget.
#
# ALL_REQUESTS is the only one evaluated in middleware, so it is the only one
# that counts requests rejected before the view runs (bad API key, malformed
# session id). Without it, BACKEND_API_KEY could be brute-forced at network
# speed. Keep it generous enough to be invisible to real users.
RATE_LIMIT_ALL_REQUESTS_IP=120/minute;2000/hour
RATE_LIMIT_ASK_IP=20/minute;120/hour
RATE_LIMIT_ASK_SCOPE=10/minute;60/hour
RATE_LIMIT_ASK_APP_PROCESS=500/day
RATE_LIMIT_UPLOAD_IP=5/minute;20/hour
RATE_LIMIT_UPLOAD_SCOPE=3/minute;10/hour
RATE_LIMIT_UPLOAD_APP_PROCESS=100/day

# --- Provider timeouts / retries ---------------------------------------------
# Applied to the SDK clients, which are configured as the SINGLE retry layer --
# stacking our own wrapper on top would multiply attempts (3 x 3 = 9 calls for
# one logical request). Chat generation is the deliberate exception: it uses a
# client with SDK retries disabled and retries at most once, never on a read
# timeout, because an accepted-but-slow request may already have been billed.
PROVIDER_TIMEOUT_S=30
PROVIDER_MAX_RETRIES=2

# --- Ingest schema -----------------------------------------------------------
# Embedded in vector ids and metadata. Bump only when the stored chunk format
# changes incompatibly; older supported versions stay readable so a bump does not
# orphan live documents mid-demo, and cleanup retires them on the normal cutoff.
INGEST_SCHEMA_VERSION=1

# --- Runtime -----------------------------------------------------------------
# Set to 1 ONLY behind exactly one trusted proxy (i.e. on Render). Leave 0 for
# local Docker Compose, where forwarded headers must not be trusted.
TRUST_PROXY=0
LOG_LEVEL=INFO
# Logs question text. Enable only for evaluation runs, never in the live demo.
LOG_QUESTIONS=0

# --- Frontend ----------------------------------------------------------------
# Local Compose uses the service name. On Render this is injected from the
# backend service host; a bare hostname is normalised to https:// at startup.
BACKEND_URL=http://backend:5000
# Publishes DEMO_PASSWORD on the login page for a public portfolio demo.
# True values (case-insensitive): 1, true, yes, on. Everything else -- including
# unset, empty, or an unrecognised value -- is false and keeps the private gate.
PUBLIC_DEMO_MODE=false
